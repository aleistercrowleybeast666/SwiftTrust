config load ${PROJECT_ROOT}\Acquisition\SwiftThrust_Acquisition_Candidate\SwiftThrust_Acquisition_Candidate.ioc
get version
project name SwiftThrust_Acquisition_Candidate
project toolchain STM32CubeIDE
set userconst SWIFTTHRUST_BOARD_BOUND 0
set mode SPI1 Full_Duplex_Master
set mode SPI2 Full_Duplex_Master
set mode SDIO SD_4_bits_Wide_bus
set ip parameters SPI1 CLKPolarity SPI_POLARITY_LOW
set ip parameters SPI1 CLKPhase SPI_PHASE_2EDGE
set mode SYS Serial_Wire
set pin PB3 SPI1_SCK
lock pin PB3 true
set gpio parameters PB3 GPIO_Label CAND_ADC_SCK
set pin PB4 SPI1_MISO
lock pin PB4 true
set gpio parameters PB4 GPIO_Label CAND_ADC_DOUT
set pin PB5 SPI1_MOSI
lock pin PB5 true
set gpio parameters PB5 GPIO_Label CAND_ADC_DIN
set pin PB6 GPIO_Output
lock pin PB6 true
set gpio parameters PB6 GPIO_Label CAND_ADC_CS
set gpio parameters PB6 PinState GPIO_PIN_SET
set pin PA15 GPIO_EXTI15
lock pin PA15 true
set gpio parameters PA15 GPIO_Label CAND_ADC_DRDY
set gpio parameters PA15 GPIO_ModeDefaultEXTI GPIO_MODE_IT_FALLING
set pin PA8 RCC_MCO_1
lock pin PA8 true
set gpio parameters PA8 GPIO_Label CAND_ADC_CLK
set pin PC8 SDIO_D0
lock pin PC8 true
set gpio parameters PC8 GPIO_Label CAND_TF_D0
set pin PC9 SDIO_D1
lock pin PC9 true
set gpio parameters PC9 GPIO_Label CAND_TF_D1
set pin PC10 SDIO_D2
lock pin PC10 true
set gpio parameters PC10 GPIO_Label CAND_TF_D2
set pin PC11 SDIO_D3
lock pin PC11 true
set gpio parameters PC11 GPIO_Label CAND_TF_D3
set pin PC12 SDIO_CK
lock pin PC12 true
set gpio parameters PC12 GPIO_Label CAND_TF_CLK
set pin PD2 SDIO_CMD
lock pin PD2 true
set gpio parameters PD2 GPIO_Label CAND_TF_CMD
set pin PA9 GPIO_Input
lock pin PA9 true
set gpio parameters PA9 GPIO_Label CAND_TF_CARD_DETECT
set gpio parameters PA9 GPIO_PuPd GPIO_PULLUP
set pin PB13 SPI2_SCK
lock pin PB13 true
set gpio parameters PB13 GPIO_Label CAND_RADIO_SCK
set pin PB14 SPI2_MISO
lock pin PB14 true
set gpio parameters PB14 GPIO_Label CAND_RADIO_MISO
set pin PB15 SPI2_MOSI
lock pin PB15 true
set gpio parameters PB15 GPIO_Label CAND_RADIO_MOSI
set pin PB12 GPIO_Output
lock pin PB12 true
set gpio parameters PB12 GPIO_Label CAND_RADIO_CS
set gpio parameters PB12 PinState GPIO_PIN_SET
set pin PC6 GPIO_Input
lock pin PC6 true
set gpio parameters PC6 GPIO_Label CAND_RADIO_BUSY
set pin PC7 GPIO_EXTI7
lock pin PC7 true
set gpio parameters PC7 GPIO_Label CAND_RADIO_DIO1
set gpio parameters PC7 GPIO_ModeDefaultEXTI GPIO_MODE_IT_RISING
set pin PB2 GPIO_Output
lock pin PB2 true
set gpio parameters PB2 GPIO_Label CAND_RADIO_NRESET
set gpio parameters PB2 PinState GPIO_PIN_SET
set pin PC0 ADC1_IN10
lock pin PC0 true
set gpio parameters PC0 GPIO_Label CAND_ACQUISITION_BATTERY
set pin PA4 GPIO_Output
lock pin PA4 true
set gpio parameters PA4 GPIO_Label CAND_LED_VOLT_1
set gpio parameters PA4 PinState GPIO_PIN_RESET
set pin PA5 GPIO_Output
lock pin PA5 true
set gpio parameters PA5 GPIO_Label CAND_LED_VOLT_2
set gpio parameters PA5 PinState GPIO_PIN_RESET
set pin PA6 GPIO_Output
lock pin PA6 true
set gpio parameters PA6 GPIO_Label CAND_LED_VOLT_3
set gpio parameters PA6 PinState GPIO_PIN_RESET
set pin PA7 GPIO_Output
lock pin PA7 true
set gpio parameters PA7 GPIO_Label CAND_LED_VOLT_4
set gpio parameters PA7 PinState GPIO_PIN_RESET
set pin PA13 SYS_JTMS-SWDIO
lock pin PA13 true
set gpio parameters PA13 GPIO_Label CAND_SWDIO
set pin PA14 SYS_JTCK-SWCLK
lock pin PA14 true
set gpio parameters PA14 GPIO_Label CAND_SWCLK
set pin PA2 USART2_TX
lock pin PA2 true
set gpio parameters PA2 GPIO_Label CAND_DEBUG_UART_TX
set pin PA3 USART2_RX
lock pin PA3 true
set gpio parameters PA3 GPIO_Label CAND_DEBUG_UART_RX
set pin PA0-WKUP TIM2_CH1
lock pin PA0-WKUP true
set gpio parameters PA0-WKUP GPIO_Label CAND_IGNITION_SIGNAL
set gpio parameters PA0-WKUP GPIO_PuPd GPIO_PULLDOWN
set pin PB10 GPIO_Output
lock pin PB10 true
set gpio parameters PB10 GPIO_Label CAND_LINK_LED
set gpio parameters PB10 PinState GPIO_PIN_RESET
set pin "PH0 - OSC_IN" RCC_OSC_IN
lock pin "PH0 - OSC_IN" true
set gpio parameters PH0.* GPIO_Label CAND_HSE_IN
set pin "PH1 - OSC_OUT" RCC_OSC_OUT
lock pin "PH1 - OSC_OUT" true
set gpio parameters PH1.* GPIO_Label CAND_HSE_OUT
set userconst SWIFTTHRUST_ADC_AVDD_MV_CANDIDATE 5000
set userconst SWIFTTHRUST_ADC_DVDD_MV_CANDIDATE 3300
set userconst SWIFTTHRUST_BRIDGE_EXC_MV_CANDIDATE 5000
get mode active SPI1
get mode active SPI2
get mode active SDIO
set mode USART2 Asynchronous
set ip parameters USART2 BaudRate 115200
set ip parameters USART2 WordLength WORDLENGTH_8B
set ip parameters USART2 StopBits STOPBITS_1
set ip parameters USART2 Parity PARITY_NONE
set mode TIM2 "PWM Generation1 CH1"
set mode TIM2 Internal
set mode TIM2 OPM_bit
set ip parameters TIM2 Prescaler 95
set ip parameters TIM2 Period 1000000
set ip parameters TIM2 OCMode_PWM TIM_OCMODE_PWM2
set ip parameters TIM2 Pulse 1
set ip parameters TIM2 TIM_OnePulse_Mode TIM_OPMODE_SINGLE
set ip parameters ADC1 SamplingTime-0#ChannelRegularConversion ADC_SAMPLETIME_480CYCLES
set mode RCC HSE-External-Oscillator
set ip parameters RCC HSE_VALUE 8192000
set ip parameters RCC PLLM 8
set ip parameters RCC PLLN 375
set ip parameters RCC PLLP RCC_PLLP_DIV4
set ip parameters RCC PLLQ 8
set ip parameters RCC PLLSourceVirtual RCC_PLLSOURCE_HSE
set ip parameters RCC SYSCLKSource RCC_SYSCLKSOURCE_PLLCLK
set ip parameters RCC APB1CLKDivider RCC_HCLK_DIV2
set ip parameters RCC RCC_MCO1Source RCC_MCO1SOURCE_HSE
set ip parameters RCC RCC_MCODiv1 RCC_MCODIV_2
isPluginError "Pinout & Configuration"
isPluginError "Clock Configuration"
get pinout
config save ${PROJECT_ROOT}\Acquisition\SwiftThrust_Acquisition_Candidate\SwiftThrust_Acquisition_Candidate.ioc
exit
